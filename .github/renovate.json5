{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices",
    ":pinAllExceptPeerDependencies",
    "customManagers:githubActionsVersions",
    "schedule:monthly",
  ],

  // Also pulled in nested via `config:best-practices`. It sets 3 days in a
  // packageRule, which would override the top-level minimumReleaseAge.
  ignorePresets: ["security:minimumReleaseAgeNpm"],

  configMigration: true,
  lockFileMaintenance: {
    enabled: true,
  },
  minimumReleaseAge: "14 days",
  semanticCommits: "disabled",
  separateMinorPatch: true,

  packageRules: [
    {
      description: "Skip Minimum Release Age for update types that carry no usable release timestamp",
      matchUpdateTypes: [
        "bump",
        "lockFileMaintenance",
        "lockfileUpdate",
        "pin",
        "replacement",
        "rollback",
      ],
      minimumReleaseAge: null,
    },
    {
      // Without this, a pinned runner version would be held back forever, silently.
      description: "Exempt github-runners, which provides no release timestamps to age against",
      matchDatasources: ["github-runners"],
      minimumReleaseAge: null,
    },
  ],
}
